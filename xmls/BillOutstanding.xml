<?xml version='1.0' encoding='utf-8'?>
<!--
  Bill-wise outstanding — V4 REWRITE (2026-07-09)
  Translated from user's working DSL TDL (TDKBillOutstanding_v3.tdl) which produced
  the verified response XML with 2,167 pending bills across all Sundry Debtor +
  Creditor ledgers, including all 5 Aai Gee Krishi bills.

  Key pattern (from working V3 DSL):
    - Collection Type: Bill  (Tally-native, no ledger-walk needed)
    - Filter: Cleared="No"   (Tally-managed pending flag; skip cleared bills)
    - Bill object exposes: $Name, $Parent, $BillDate, $BillCreditPeriod,
      $OpeningBalance, $ClosingBalance directly (no context climbing).

  Response fields (matches processBillOutstanding parser exactly):
      LedgerName, BillName, BillDate, DueDate, Amount, PendingAmount,
      BillType (empty for now), AlterId (empty), VoucherGuid (empty), DrCr, LedgerParent
-->
<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Data</TYPE>
    <ID>TDKBillOutstandingReportV4</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XMLFormat</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>$$COMPANY_NAME</SVCURRENTCOMPANY>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>

          <REPORT NAME="TDKBillOutstandingReportV4">
            <FORMS>TDKBOFormV4</FORMS>
          </REPORT>

          <FORM NAME="TDKBOFormV4">
            <PARTS>TDKBOBodyPartV4</PARTS>
            <XMLTAG>ENVELOPE</XMLTAG>
          </FORM>

          <PART NAME="TDKBOBodyPartV4">
            <LINES>TDKBODetailLineV4</LINES>
            <REPEAT>TDKBODetailLineV4 : TDKBOPendingBillsV4</REPEAT>
            <SCROLLED>Vertical</SCROLLED>
          </PART>

          <LINE NAME="TDKBODetailLineV4">
            <FIELDS>TDKBOLedgerName,TDKBOBillName,TDKBOBillDate,TDKBODueDate,TDKBOAmount,TDKBOPendingAmount,TDKBODrCr,TDKBOLedgerParent</FIELDS>
            <XMLTAG>BILLROW</XMLTAG>
          </LINE>

          <FIELD NAME="TDKBOLedgerName">
            <SET>$Parent</SET>
            <XMLTAG>LedgerName</XMLTAG>
          </FIELD>
          <FIELD NAME="TDKBOBillName">
            <SET>$Name</SET>
            <XMLTAG>BillName</XMLTAG>
          </FIELD>
          <FIELD NAME="TDKBOBillDate">
            <SET>$BillDate</SET>
            <XMLTAG>BillDate</XMLTAG>
          </FIELD>
          <FIELD NAME="TDKBODueDate">
            <SET>if $$IsEmpty:$BillCreditPeriod then "" else ($BillDate + $BillCreditPeriod)</SET>
            <XMLTAG>DueDate</XMLTAG>
          </FIELD>
          <FIELD NAME="TDKBOAmount">
            <SET>$OpeningBalance</SET>
            <XMLTAG>Amount</XMLTAG>
          </FIELD>
          <FIELD NAME="TDKBOPendingAmount">
            <SET>$ClosingBalance</SET>
            <XMLTAG>PendingAmount</XMLTAG>
          </FIELD>
          <FIELD NAME="TDKBODrCr">
            <SET>if $$IsDr:$ClosingBalance then "Dr" else "Cr"</SET>
            <XMLTAG>DrCr</XMLTAG>
          </FIELD>
          <FIELD NAME="TDKBOLedgerParent">
            <SET>$Parent</SET>
            <XMLTAG>LedgerParent</XMLTAG>
          </FIELD>

          <COLLECTION NAME="TDKBOPendingBillsV4">
            <TYPE>Bill</TYPE>
            <CLEARED>No</CLEARED>
            <FETCH>Name,Parent,BillDate,BillCreditPeriod,OpeningBalance,ClosingBalance</FETCH>
            <FILTER>TDKBONonBlankBillV4</FILTER>
          </COLLECTION>

          <SYSTEM TYPE="Formulae" NAME="TDKBONonBlankBillV4">NOT $$IsEmpty:$Name</SYSTEM>

        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
