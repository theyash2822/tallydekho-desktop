<?xml version='1.0' encoding='utf-8'?>
<!--
  Bill-wise outstanding — V8 (2026-07-10)

  V4→V7 all used REPORT-based export (TYPE=Data + REPORT/FORM/PART/LINE/FIELD
  scaffolding). V7 device-tested: `bill_outstanding` DB still 0 rows, no
  processBillOutstanding log line ever fired → Tally silently returned empty.

  V8 pivots to COLLECTION-based export — the exact pattern used by
  LedgerFull.xml, GroupMaster.xml, UnitFull.xml, VoucherTypeFull.xml,
  StockGroupFull.xml (all shipping thousands of rows reliably every sync).

  Key differences vs V7:
    • HEADER TYPE=Collection (not Data), ID=TDKPendingBills (not TDKPendingBillsReport)
    • No REPORT / FORM / PART / LINE / FIELD blocks
    • Just <COLLECTION> with <Compute> fields — Tally exports collection directly
    • FILTER declared inline on the collection (native TDL filter, same formula)

  Response shape (parallel field arrays under <ENVELOPE>, matches
  processBillOutstanding parser + normalizeEnvelope):
    LedgerName, BillName, BillDate, DueDate, Amount, PendingAmount, DrCr, LedgerParent
-->
<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Collection</TYPE>
    <ID>TDKPendingBills</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>XML (Data Interchange)</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>$$COMPANY_NAME</SVCURRENTCOMPANY>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <COLLECTION ISMODIFY="No" ISFIXED="No" ISINITIALIZE="No" ISOPTION="No" ISINTERNAL="No" NAME="TDKPendingBills">
            <TYPE>Bill</TYPE>
            <FETCH>Name,Parent,BillDate,BillCreditPeriod,OpeningBalance,ClosingBalance,IsCleared</FETCH>
            <FILTER>TDKBillIsPending</FILTER>
            <Compute>LedgerName:$Parent</Compute>
            <Compute>BillName:$Name</Compute>
            <Compute>BillDate:$BillDate</Compute>
            <Compute>DueDate:if $$IsEmpty:$BillCreditPeriod then "" else ($BillDate + $BillCreditPeriod)</Compute>
            <Compute>Amount:$OpeningBalance</Compute>
            <Compute>PendingAmount:$ClosingBalance</Compute>
            <Compute>DrCr:if $$IsDr:$ClosingBalance then "Dr" else "Cr"</Compute>
            <Compute>LedgerParent:$Parent</Compute>
          </COLLECTION>
          <SYSTEM TYPE="Formulae" NAME="TDKBillIsPending">(NOT $$IsEmpty:$Name) AND (NOT $$IsZero:$ClosingBalance)</SYSTEM>
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
