<?xml version='1.0' encoding='utf-8'?>
<!--
  Bill-wise outstanding — REWRITE (2026-07-09)
  Purpose: for every Sundry Debtor + Sundry Creditor ledger, emit one row per pending bill.
  Response shape targets our processBillOutstanding parser (ingestProcessor.js:1931):
      LedgerName, BillName, BillDate, DueDate, Amount, PendingAmount, BillType, AlterId, VoucherGuid

  Design:
    - Outer walker: Ledger collection filtered to Sundry Debtor/Creditor parents.
    - Inner walker: BillAllocations sub-collection (Tally-native), one row per bill.
    - Uses WALK to descend into BillAllocations so $..Name resolves to the ledger's name.
    - Filter for non-zero pending bills only (skip fully-cleared or synthetic rows).
-->
<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Data</TYPE>
    <ID>TDKBillOutstandingReport</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XMLFormat</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>$$COMPANY_NAME</SVCURRENTCOMPANY>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <REPORT NAME="TDKBillOutstandingReport">
            <FORMS>TDKBillOutstandingForm</FORMS>
          </REPORT>

          <FORM NAME="TDKBillOutstandingForm">
            <PARTS>TDKBillOutstandingPart</PARTS>
            <XMLTAG>ENVELOPE</XMLTAG>
          </FORM>

          <PART NAME="TDKBillOutstandingPart">
            <LINES>TDKBillOutstandingLine</LINES>
            <REPEAT>TDKBillOutstandingLine : TDKBillOutstandingCollection</REPEAT>
            <SCROLLED>Vertical</SCROLLED>
          </PART>

          <LINE NAME="TDKBillOutstandingLine">
            <FIELDS>FldLedger,FldBill,FldBillDate,FldDueDate,FldAmount,FldPending,FldBillType,FldAlter,FldGuid</FIELDS>
            <XMLTAG>BILLROW</XMLTAG>
          </LINE>

          <FIELD NAME="FldLedger">
            <SET>$..Name</SET>
            <XMLTAG>LedgerName</XMLTAG>
          </FIELD>
          <FIELD NAME="FldBill">
            <SET>$Name</SET>
            <XMLTAG>BillName</XMLTAG>
          </FIELD>
          <FIELD NAME="FldBillDate">
            <SET>if $$IsEmpty:$BillDate then "" else $$PyrlYYYYMMDDFormat:$BillDate:"-"</SET>
            <XMLTAG>BillDate</XMLTAG>
          </FIELD>
          <FIELD NAME="FldDueDate">
            <SET>if $$IsEmpty:$BillCreditPeriod then "" else $$PyrlYYYYMMDDFormat:($BillDate + $BillCreditPeriod):"-"</SET>
            <XMLTAG>DueDate</XMLTAG>
          </FIELD>
          <FIELD NAME="FldAmount">
            <SET>if $$IsDebit:$Amount then -$$NumValue:$Amount else $$NumValue:$Amount</SET>
            <XMLTAG>Amount</XMLTAG>
          </FIELD>
          <FIELD NAME="FldPending">
            <SET>if $$IsDebit:$ClosingBalance then -$$NumValue:$ClosingBalance else $$NumValue:$ClosingBalance</SET>
            <XMLTAG>PendingAmount</XMLTAG>
          </FIELD>
          <FIELD NAME="FldBillType">
            <SET>$BillType</SET>
            <XMLTAG>BillType</XMLTAG>
          </FIELD>
          <FIELD NAME="FldAlter">
            <SET>$$String:$AlterId</SET>
            <XMLTAG>AlterId</XMLTAG>
          </FIELD>
          <FIELD NAME="FldGuid">
            <SET>$..Guid</SET>
            <XMLTAG>VoucherGuid</XMLTAG>
          </FIELD>

          <COLLECTION NAME="TDKBillOutstandingCollection">
            <SOURCE COLLECTION>TDKLedgerBillsCollection</SOURCE COLLECTION>
            <WALK>BillAllocations</WALK>
            <FILTER>FltrNonZero</FILTER>
          </COLLECTION>

          <COLLECTION NAME="TDKLedgerBillsCollection">
            <TYPE>Ledger</TYPE>
            <FETCH>Name,Parent,BillAllocations,AlterId,Guid</FETCH>
            <FILTER>FltrDebtorCreditor</FILTER>
          </COLLECTION>

          <SYSTEM TYPE="Formulae" NAME="FltrDebtorCreditor">$$IsSundryDebtorOrCreditor:$Parent</SYSTEM>
          <SYSTEM TYPE="Formulae" NAME="FltrNonZero">NOT $$IsZero:$ClosingBalance</SYSTEM>
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
