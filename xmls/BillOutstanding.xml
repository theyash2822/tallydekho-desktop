<?xml version="1.0" encoding="utf-8"?>
<!--
  Thin export envelope for pre-loaded report TDKBillOutstandingWorking.
  Requires TDKBillOutstanding.tdl loaded via tally.ini (Option B).
  Dates filled by syncHelperWithDate ($$FROM_DATE / $$TO_DATE).
-->
<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Data</TYPE>
    <ID>TDKBillOutstandingWorking</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>$$COMPANY_NAME</SVCURRENTCOMPANY>
        <SVFROMDATE TYPE="Date">$$FROM_DATE</SVFROMDATE>
        <SVTODATE TYPE="Date">$$TO_DATE</SVTODATE>
      </STATICVARIABLES>
    </DESC>
  </BODY>
</ENVELOPE>
