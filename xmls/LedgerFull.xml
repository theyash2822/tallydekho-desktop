<ENVELOPE>
    <HEADER>
        <VERSION>1</VERSION>
        <TALLYREQUEST>Export</TALLYREQUEST>
        <TYPE>Collection</TYPE>
        <ID>Ledgers</ID>
    </HEADER>
    <BODY>
        <DESC>
            <STATICVARIABLES>
                <SVEXPORTFORMAT>XML (Data Interchange)</SVEXPORTFORMAT>
                <SVCURRENTCOMPANY>$$COMPANY_NAME</SVCURRENTCOMPANY>
            </STATICVARIABLES>
            <TDL>
                <TDLMESSAGE>
                    <COLLECTION ISMODIFY="No" ISFIXED="No" ISINITIALIZE="No" ISOPTION="No" ISINTERNAL="No" NAME="Ledgers">
                        <TYPE>Ledger</TYPE>
                        <BELONGSTO>Yes</BELONGSTO>
                        <FETCH>GSTRegistrationDetails,BankAccountDetails</FETCH>
                        <NATIVEMETHOD>Name,Guid,ALTERID,PARENT,OPENINGBALANCE,MAILINGNAME,LedgerMobile,Gsttypeofsupply,LedStateName,Email,Pincode,IncomeTaxNumber</NATIVEMETHOD>
                        <Compute>Parentguid:$Guid:Group:$Parent</Compute>
                        <Compute>MAILINGADDRESS:if $$IsEmpty:$Address then '' else $$FullList:Address:$Address</Compute>
                        <Compute>MAILINGSTATE:$LedStateName</Compute>
                        <Compute>MAILINGCOUNTRY:$CountryName</Compute>
                        <Compute>OPENINGBALANCE:if $$IsDebit:$OpeningBalance then -$$NumValue:$OpeningBalance else $$NumValue:$OpeningBalance</Compute>
                        <Compute>CLOSINGBALANCE:if $$IsDebit:$ClosingBalance then -$$NumValue:$ClosingBalance else $$NumValue:$ClosingBalance</Compute>
                        <Compute>Pincode:$Pincode</Compute>
                        <Compute>EMAIL:$Email</Compute>
                        <Compute>PHONE:$LedgerPHONE</Compute>
                        <Compute>ITPAN:$IncomeTaxNumber</Compute>
                        <Compute>GSTIN:$PartyGSTIN</Compute>
                        <Compute>GSTREGISTRATIONTYPE:$GSTRegistrationType</Compute>
                        <Compute>GSTDUTYHEAD:$Gstdutyhead</Compute>
                        <Compute>TAXRATE:if $$IsEmpty:$RateOfTaxCalculation then '0' else $$String:$RateOfTaxCalculation</Compute>
                        <Compute>ALIAS:$OnlyAlias</Compute>
                        <Compute>ISREVENUE:$ISREVENUE</Compute>
                        <Compute>ISDEEMEDPOSITIVE:if $IsDeemedPositive then 1 else 0</Compute>
                        <Compute>BANKACCOUNTHOLDER:if Not $$IsEmpty:$BankAccHolderName then $BankAccHolderName else ""</Compute>
                        <!-- Prefer BankAccountDetails (matches TallyPrime ledger Bank A/c No / IFSC); fall back to legacy fields -->
                        <Compute>BANKACCOUNTNUMBER:if Not $$IsEmpty:$BankAccountDetails[1].AccountNumber then $BankAccountDetails[1].AccountNumber else (if Not $$IsEmpty:$BankDetails then $BankDetails else "")</Compute>
                        <Compute>BANKIFSC:if Not $$IsEmpty:$BankAccountDetails[1].IFSCCode then $BankAccountDetails[1].IFSCCode else $IFSCode</Compute>
                        <Compute>BANKSWIFT:$BANKSWIFT</Compute>
                        <Compute>BANKBRANCH:if Not $$IsEmpty:$BankBranchName then $BankBranchName else ''</Compute>
                        <Compute>BANKNAME:if Not $$IsEmpty:$BankAccountDetails[1].BankName then $BankAccountDetails[1].BankName else (if Not $$IsEmpty:$BankName then $BankName else "")</Compute>
                        <Compute>CREDITLIMIT:if $$IsEmpty:$CreditLimit then 0 else $$NumValue:$CreditLimit</Compute>
                        <Compute>DESCRIPTION:$Description</Compute>
                    </COLLECTION>
                </TDLMESSAGE>
            </TDL>
        </DESC>
    </BODY>
</ENVELOPE>