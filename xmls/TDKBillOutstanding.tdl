;; -----------------------------------------------------------------------------
;; TallyDekho - Bill Outstanding (minimal / sync-safe)
;; Report ID: TDKBillOutstandingWorking
;;
;; Design goals vs previous WORKING.tdl:
;; - NO Gateway menu hook (sync-only; less UI crash surface)
;; - NO $DSPAccName formula (known heavy / fragile)
;; - NO BillDate + BillCreditPeriod due-date math: CreditPeriod is exported as
;;   Tally's text ("15 Days", blank if none) and the backend adds it to BillDate
;;   (verified live 2026-09-30 on 2,008 bills)
;; - NO Cleared:No / ledger / sundry filters (those emptied or stressed Tally)
;; - Simple Type:Bill collection; filter blank bill names only
;; - XML shape: ENVELOPE / BILLROW / field tags (matches proven export)
;;
;; Report TDKBillOutstandingHealth prints TDKSTATUS so the desktop can tell
;; "TDL loaded" apart from "TDL not loaded" without relying on bill rows.
;; Keep TDKBOH Version in step with TDL_VERSION in util/tdlHealth.js.
;;
;; TallyPrime prints nothing over HTTP export for lines that are not repeated
;; over a collection (static lines and "Repeat : <Line>" + "Set : 1" both gave
;; <ENVELOPE></ENVELOPE> on TallyPrime 7.0). Every line here therefore repeats
;; over a collection:
;;   - health: one TDKSTATUS per loaded company (desktop reads the first);
;;     no company loaded -> no row -> desktop treats health as unconfirmed
;;   - context: only the loaded company whose name equals SVCurrentCompany, so
;;     a company that is not loaded yields no TDKCONTEXT and the desktop keeps
;;     the old bills
;;   - every BILLROW carries the company it was read from
;; -----------------------------------------------------------------------------

[Report: TDKBillOutstandingHealth]
    Form          : TDKBOH Form
    Title         : "TallyDekho Bill Outstanding Health"
    Keep XML Case : Yes

[Form: TDKBOH Form]
    Parts   : TDKBOH Body
    XML Tag : ENVELOPE

[Part: TDKBOH Body]
    Lines   : TDKBOH Line
    Repeat  : TDKBOH Line : TDKBO LoadedCompanies

[Line: TDKBOH Line]
    Fields  : TDKBOH Active, TDKBOH Version, TDKBOH Report
    XML Tag : TDKSTATUS

[Field: TDKBOH Active]
    Use     : Name Field
    Set As  : "YES"
    XML Tag : ACTIVE

[Field: TDKBOH Version]
    Use     : Name Field
    Set As  : "1.1.2"
    XML Tag : VERSION

[Field: TDKBOH Report]
    Use     : Name Field
    Set As  : "TDKBillOutstandingWorking"
    XML Tag : REPORT

[Report: TDKBillOutstandingWorking]
    Form          : TDKBO Form
    Title         : "TallyDekho Bill Outstanding"
    Variable      : SVFromDate, SVToDate
    Keep XML Case : Yes

[Form: TDKBO Form]
    Parts   : TDKBO Context, TDKBO Body
    XML Tag : ENVELOPE

[Part: TDKBO Context]
    Lines   : TDKBO ContextLine
    Repeat  : TDKBO ContextLine : TDKBO CurrentCompany

[Line: TDKBO ContextLine]
    Fields  : TDKBO ContextCompany
    XML Tag : TDKCONTEXT

[Field: TDKBO ContextCompany]
    Use     : Name Field
    Set As  : $Name
    XML Tag : COMPANY

[Part: TDKBO Body]
    Lines   : TDKBO Line
    Repeat  : TDKBO Line : TDKBO Bills
    Scroll  : Vertical

[Line: TDKBO Line]
    Fields  : TDKBO LedgerName, TDKBO BillName, TDKBO BillDate, TDKBO DueDate, TDKBO CreditPeriod, TDKBO Amount, TDKBO PendingAmount, TDKBO DrCr, TDKBO LedgerParent, TDKBO Company
    XML Tag : BILLROW

[Field: TDKBO Company]
    Use     : Name Field
    Set As  : ##SVCurrentCompany
    XML Tag : Company

[Field: TDKBO LedgerName]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LedgerName

[Field: TDKBO BillName]
    Use     : Name Field
    Set As  : $Name
    XML Tag : BillName

[Field: TDKBO BillDate]
    Use     : Name Field
    Set As  : If $$IsEmpty:$BillDate Then "" Else $$PyrlYYYYMMDDFormat:$BillDate:"-"
    XML Tag : BillDate

[Field: TDKBO DueDate]
    Use     : Name Field
    Set As  : ""
    XML Tag : DueDate

[Field: TDKBO CreditPeriod]
    Use     : Name Field
    Set As  : $BillCreditPeriod
    XML Tag : CreditPeriod

[Field: TDKBO Amount]
    Use     : Name Field
    Set As  : $OpeningBalance
    XML Tag : Amount

[Field: TDKBO PendingAmount]
    Use     : Name Field
    Set As  : $ClosingBalance
    XML Tag : PendingAmount

[Field: TDKBO DrCr]
    Use     : Name Field
    Set As  : If $$IsDr:$ClosingBalance Then "Dr" Else "Cr"
    XML Tag : DrCr

[Field: TDKBO LedgerParent]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LedgerParent

[Collection: TDKBO Bills]
    Type   : Bill
    Fetch  : Name, Parent, BillDate, BillCreditPeriod, OpeningBalance, ClosingBalance
    Filter : TDKBO NonBlankBill

[Collection: TDKBO LoadedCompanies]
    Type   : Company
    Fetch  : Name

[Collection: TDKBO CurrentCompany]
    Type   : Company
    Fetch  : Name
    Filter : TDKBO IsRequestedCompany

[System: Formula]
    TDKBO NonBlankBill       : NOT $$IsEmpty:$Name
    TDKBO IsRequestedCompany : $Name = ##SVCurrentCompany

;; ===== TEMPORARY DIAGNOSTIC PROBES — BEGIN (delete through END after diagnosis) =====
;; Round 1 (done): only lines inside a "Scroll : Vertical" part print over HTTP
;; Export/Data, whatever their data source.
;; Round 2: does ##SVCurrentCompany inside a scrolling metadata line report the
;; requested company, and what happens when that company is not open?
;;   TDKProbeContext      : one fixed line, scrolling part, no collection
;;   TDKProbeContextBills : same fixed line + BILLROW-like lines repeated over
;;                          TDKBO Bills, all in ONE scrolling part (final syntax)
;; Read with scripts/tdl-layout-probe.js. Nothing in the desktop app calls these.

[Report: TDKProbeContext]
    Form          : TDKProbe Context Form
    Keep XML Case : Yes

[Form: TDKProbe Context Form]
    Parts   : TDKProbe Context Part
    XML Tag : ENVELOPE

[Part: TDKProbe Context Part]
    Lines   : TDKProbe Context Line
    Scroll  : Vertical

[Report: TDKProbeContextBills]
    Form          : TDKProbe ContextBills Form
    Variable      : SVFromDate, SVToDate
    Keep XML Case : Yes

[Form: TDKProbe ContextBills Form]
    Parts   : TDKProbe ContextBills Part
    XML Tag : ENVELOPE

[Part: TDKProbe ContextBills Part]
    Lines   : TDKProbe Context Line, TDKProbe Bill Line
    Repeat  : TDKProbe Bill Line : TDKBO Bills
    Scroll  : Vertical

[Line: TDKProbe Context Line]
    Fields  : TDKProbe Active, TDKProbe Version, TDKProbe CurrentCompany, TDKProbe CompanyObject
    XML Tag : PROBE

[Line: TDKProbe Bill Line]
    Fields  : TDKProbe BillLedger, TDKProbe BillName, TDKProbe BillCompany
    XML Tag : PROBEBILL

[Field: TDKProbe Active]
    Use     : Name Field
    Set As  : "YES"
    XML Tag : ACTIVE

[Field: TDKProbe Version]
    Use     : Name Field
    Set As  : "PROBE"
    XML Tag : VERSION

[Field: TDKProbe CurrentCompany]
    Use     : Name Field
    Set As  : ##SVCurrentCompany
    XML Tag : CURRENTCOMPANY

;; Name of the Company object Tally resolves for SVCurrentCompany; blank if
;; Tally has no such company open (tells "echo" apart from "really open").
[Field: TDKProbe CompanyObject]
    Use     : Name Field
    Set As  : $Name:Company:##SVCurrentCompany
    XML Tag : COMPANYOBJECT

[Field: TDKProbe BillLedger]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LEDGER

[Field: TDKProbe BillName]
    Use     : Name Field
    Set As  : $Name
    XML Tag : BILL

[Field: TDKProbe BillCompany]
    Use     : Name Field
    Set As  : ##SVCurrentCompany
    XML Tag : COMPANY

;; ===== TEMPORARY DIAGNOSTIC PROBES — END =====
