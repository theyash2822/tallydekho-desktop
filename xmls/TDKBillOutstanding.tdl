;; -----------------------------------------------------------------------------
;; TallyDekho - Bill Outstanding (minimal / sync-safe)
;; Report ID: TDKBillOutstandingWorking
;;
;; Design goals vs previous WORKING.tdl:
;; - NO Gateway menu hook (sync-only; less UI crash surface)
;; - NO $DSPAccName formula (known heavy / fragile)
;; - NO BillDate + BillCreditPeriod due-date math: CreditPeriod is exported as
;;   Tally's text ("15 Days", blank if none) and the backend adds it to BillDate
;;   (verified live 2026-09-30 on 2,008 bills)
;; - NO Cleared:No / ledger / sundry filters (those emptied or stressed Tally)
;; - Simple Type:Bill collection; filter blank bill names only
;; - XML shape: ENVELOPE / BILLROW / field tags (matches proven export)
;;
;; Report TDKBillOutstandingHealth prints TDKSTATUS so the desktop can tell
;; "TDL loaded" apart from "TDL not loaded" without relying on bill rows.
;; Keep TDKBOH Version in step with TDL_VERSION in util/tdlHealth.js.
;;
;; TallyPrime prints nothing over HTTP export for lines that are not repeated
;; over a collection (static lines and "Repeat : <Line>" + "Set : 1" both gave
;; <ENVELOPE></ENVELOPE> on TallyPrime 7.0). Every line here therefore repeats
;; over a collection:
;;   - health: one TDKSTATUS per loaded company (desktop reads the first);
;;     no company loaded -> no row -> desktop treats health as unconfirmed
;;   - context: only the loaded company whose name equals SVCurrentCompany, so
;;     a company that is not loaded yields no TDKCONTEXT and the desktop keeps
;;     the old bills
;;   - every BILLROW carries the company it was read from
;; -----------------------------------------------------------------------------

[Report: TDKBillOutstandingHealth]
    Form          : TDKBOH Form
    Title         : "TallyDekho Bill Outstanding Health"
    Keep XML Case : Yes

[Form: TDKBOH Form]
    Parts   : TDKBOH Body
    XML Tag : ENVELOPE

[Part: TDKBOH Body]
    Lines   : TDKBOH Line
    Repeat  : TDKBOH Line : TDKBO LoadedCompanies

[Line: TDKBOH Line]
    Fields  : TDKBOH Active, TDKBOH Version, TDKBOH Report
    XML Tag : TDKSTATUS

[Field: TDKBOH Active]
    Use     : Name Field
    Set As  : "YES"
    XML Tag : ACTIVE

[Field: TDKBOH Version]
    Use     : Name Field
    Set As  : "1.1.2"
    XML Tag : VERSION

[Field: TDKBOH Report]
    Use     : Name Field
    Set As  : "TDKBillOutstandingWorking"
    XML Tag : REPORT

[Report: TDKBillOutstandingWorking]
    Form          : TDKBO Form
    Title         : "TallyDekho Bill Outstanding"
    Variable      : SVFromDate, SVToDate
    Keep XML Case : Yes

[Form: TDKBO Form]
    Parts   : TDKBO Context, TDKBO Body
    XML Tag : ENVELOPE

[Part: TDKBO Context]
    Lines   : TDKBO ContextLine
    Repeat  : TDKBO ContextLine : TDKBO CurrentCompany

[Line: TDKBO ContextLine]
    Fields  : TDKBO ContextCompany
    XML Tag : TDKCONTEXT

[Field: TDKBO ContextCompany]
    Use     : Name Field
    Set As  : $Name
    XML Tag : COMPANY

[Part: TDKBO Body]
    Lines   : TDKBO Line
    Repeat  : TDKBO Line : TDKBO Bills
    Scroll  : Vertical

[Line: TDKBO Line]
    Fields  : TDKBO LedgerName, TDKBO BillName, TDKBO BillDate, TDKBO DueDate, TDKBO CreditPeriod, TDKBO Amount, TDKBO PendingAmount, TDKBO DrCr, TDKBO LedgerParent, TDKBO Company
    XML Tag : BILLROW

[Field: TDKBO Company]
    Use     : Name Field
    Set As  : ##SVCurrentCompany
    XML Tag : Company

[Field: TDKBO LedgerName]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LedgerName

[Field: TDKBO BillName]
    Use     : Name Field
    Set As  : $Name
    XML Tag : BillName

[Field: TDKBO BillDate]
    Use     : Name Field
    Set As  : If $$IsEmpty:$BillDate Then "" Else $$PyrlYYYYMMDDFormat:$BillDate:"-"
    XML Tag : BillDate

[Field: TDKBO DueDate]
    Use     : Name Field
    Set As  : ""
    XML Tag : DueDate

[Field: TDKBO CreditPeriod]
    Use     : Name Field
    Set As  : $BillCreditPeriod
    XML Tag : CreditPeriod

[Field: TDKBO Amount]
    Use     : Name Field
    Set As  : $OpeningBalance
    XML Tag : Amount

[Field: TDKBO PendingAmount]
    Use     : Name Field
    Set As  : $ClosingBalance
    XML Tag : PendingAmount

[Field: TDKBO DrCr]
    Use     : Name Field
    Set As  : If $$IsDr:$ClosingBalance Then "Dr" Else "Cr"
    XML Tag : DrCr

[Field: TDKBO LedgerParent]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LedgerParent

[Collection: TDKBO Bills]
    Type   : Bill
    Fetch  : Name, Parent, BillDate, BillCreditPeriod, OpeningBalance, ClosingBalance
    Filter : TDKBO NonBlankBill

[Collection: TDKBO LoadedCompanies]
    Type   : Company
    Fetch  : Name

[Collection: TDKBO CurrentCompany]
    Type   : Company
    Fetch  : Name
    Filter : TDKBO IsRequestedCompany

[System: Formula]
    TDKBO NonBlankBill       : NOT $$IsEmpty:$Name
    TDKBO IsRequestedCompany : $Name = ##SVCurrentCompany

;; ===== TEMPORARY DIAGNOSTIC PROBES — BEGIN (delete through END after diagnosis) =====
;; Purpose: find why only BILLROW lines print over HTTP Export/Data.
;; Six reports, identical except for two variables:
;;   data source : none (fixed line) | TDKBO Bills | TDKBO LoadedCompanies
;;   layout      : body part with "Scroll : Vertical" | without
;; No Report-level Variable, no Set, no filters beyond the reused collections.
;; Read with scripts/tdl-layout-probe.js. Nothing in the desktop app calls these.

[Report: TDKProbeFixedNoScroll]
    Form          : TDKProbe FixedNoScroll Form
    Keep XML Case : Yes

[Form: TDKProbe FixedNoScroll Form]
    Parts   : TDKProbe FixedNoScroll Part
    XML Tag : ENVELOPE

[Part: TDKProbe FixedNoScroll Part]
    Lines   : TDKProbe FixedNoScroll Line

[Line: TDKProbe FixedNoScroll Line]
    Fields  : TDKProbe FixedNoScroll Type, TDKProbe Value
    XML Tag : PROBE

[Report: TDKProbeFixedScroll]
    Form          : TDKProbe FixedScroll Form
    Keep XML Case : Yes

[Form: TDKProbe FixedScroll Form]
    Parts   : TDKProbe FixedScroll Part
    XML Tag : ENVELOPE

[Part: TDKProbe FixedScroll Part]
    Lines   : TDKProbe FixedScroll Line
    Scroll  : Vertical

[Line: TDKProbe FixedScroll Line]
    Fields  : TDKProbe FixedScroll Type, TDKProbe Value
    XML Tag : PROBE

[Report: TDKProbeBillNoScroll]
    Form          : TDKProbe BillNoScroll Form
    Keep XML Case : Yes

[Form: TDKProbe BillNoScroll Form]
    Parts   : TDKProbe BillNoScroll Part
    XML Tag : ENVELOPE

[Part: TDKProbe BillNoScroll Part]
    Lines   : TDKProbe BillNoScroll Line
    Repeat  : TDKProbe BillNoScroll Line : TDKBO Bills

[Line: TDKProbe BillNoScroll Line]
    Fields  : TDKProbe BillNoScroll Type, TDKProbe Value
    XML Tag : PROBE

[Report: TDKProbeBillScroll]
    Form          : TDKProbe BillScroll Form
    Keep XML Case : Yes

[Form: TDKProbe BillScroll Form]
    Parts   : TDKProbe BillScroll Part
    XML Tag : ENVELOPE

[Part: TDKProbe BillScroll Part]
    Lines   : TDKProbe BillScroll Line
    Repeat  : TDKProbe BillScroll Line : TDKBO Bills
    Scroll  : Vertical

[Line: TDKProbe BillScroll Line]
    Fields  : TDKProbe BillScroll Type, TDKProbe Value
    XML Tag : PROBE

[Report: TDKProbeCompanyNoScroll]
    Form          : TDKProbe CompanyNoScroll Form
    Keep XML Case : Yes

[Form: TDKProbe CompanyNoScroll Form]
    Parts   : TDKProbe CompanyNoScroll Part
    XML Tag : ENVELOPE

[Part: TDKProbe CompanyNoScroll Part]
    Lines   : TDKProbe CompanyNoScroll Line
    Repeat  : TDKProbe CompanyNoScroll Line : TDKBO LoadedCompanies

[Line: TDKProbe CompanyNoScroll Line]
    Fields  : TDKProbe CompanyNoScroll Type, TDKProbe Company
    XML Tag : PROBE

[Report: TDKProbeCompanyScroll]
    Form          : TDKProbe CompanyScroll Form
    Keep XML Case : Yes

[Form: TDKProbe CompanyScroll Form]
    Parts   : TDKProbe CompanyScroll Part
    XML Tag : ENVELOPE

[Part: TDKProbe CompanyScroll Part]
    Lines   : TDKProbe CompanyScroll Line
    Repeat  : TDKProbe CompanyScroll Line : TDKBO LoadedCompanies
    Scroll  : Vertical

[Line: TDKProbe CompanyScroll Line]
    Fields  : TDKProbe CompanyScroll Type, TDKProbe Company
    XML Tag : PROBE

[Field: TDKProbe Value]
    Use     : Name Field
    Set As  : "YES"
    XML Tag : VALUE

[Field: TDKProbe Company]
    Use     : Name Field
    Set As  : $Name
    XML Tag : COMPANY

[Field: TDKProbe FixedNoScroll Type]
    Use     : Name Field
    Set As  : "FIXED_NO_SCROLL"
    XML Tag : TYPE

[Field: TDKProbe FixedScroll Type]
    Use     : Name Field
    Set As  : "FIXED_SCROLL"
    XML Tag : TYPE

[Field: TDKProbe BillNoScroll Type]
    Use     : Name Field
    Set As  : "BILL_NO_SCROLL"
    XML Tag : TYPE

[Field: TDKProbe BillScroll Type]
    Use     : Name Field
    Set As  : "BILL_SCROLL"
    XML Tag : TYPE

[Field: TDKProbe CompanyNoScroll Type]
    Use     : Name Field
    Set As  : "COMPANY_NO_SCROLL"
    XML Tag : TYPE

[Field: TDKProbe CompanyScroll Type]
    Use     : Name Field
    Set As  : "COMPANY_SCROLL"
    XML Tag : TYPE

;; ===== TEMPORARY DIAGNOSTIC PROBES — END =====
