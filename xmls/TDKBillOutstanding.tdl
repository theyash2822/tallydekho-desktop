;; -----------------------------------------------------------------------------
;; TallyDekho - Bill Outstanding (minimal / sync-safe)  version 1.1.3
;;
;; Design goals vs previous WORKING.tdl:
;; - NO Gateway menu hook (sync-only; less UI crash surface)
;; - NO $DSPAccName formula (known heavy / fragile)
;; - NO BillDate + BillCreditPeriod due-date math: CreditPeriod is exported as
;;   Tally's text ("15 Days", blank if none) and the backend adds it to BillDate
;;   (verified live 2026-09-30 on 2,008 bills)
;; - NO Cleared:No / ledger / sundry filters (those emptied or stressed Tally)
;; - Simple Type:Bill collection; filter blank bill names only
;; - XML shape: ENVELOPE / BILLROW / field tags (matches proven export)
;;
;; HTTP Export/Data on TallyPrime 7.0 only prints lines inside a part with
;; "Scroll : Vertical" (verified 2026-10-03 for fixed, Company and Bill lines).
;; A fixed line placed in the same part as a repeated line is dropped, so each
;; report below has exactly one scrolling part.
;;
;; Reports (desktop sends one request per report):
;;   TDKBillOutstandingHealth  : global, no company; one TDKSTATUS line
;;   TDKBillOutstandingContext : per company; one TDKCONTEXT line whose COMPANY
;;                               is the Company object Tally resolved for
;;                               SVCurrentCompany. A company that is not open
;;                               makes Tally answer "Could not set
;;                               'SVCurrentCompany'" instead (verified).
;;   TDKBillOutstandingWorking : per company; BILLROW per bill, each with Company
;; Keep both VERSION fields in step with TDL_VERSION in util/tdlHealth.js.
;; -----------------------------------------------------------------------------

[Report: TDKBillOutstandingHealth]
    Form          : TDKBOH Form
    Title         : "TallyDekho Bill Outstanding Health"
    Keep XML Case : Yes

[Form: TDKBOH Form]
    Parts   : TDKBOH Body
    XML Tag : ENVELOPE

[Part: TDKBOH Body]
    Lines   : TDKBOH Line
    Scroll  : Vertical

[Line: TDKBOH Line]
    Fields  : TDKBOH Active, TDKBOH Version, TDKBOH Report
    XML Tag : TDKSTATUS

[Field: TDKBOH Active]
    Use     : Name Field
    Set As  : "YES"
    XML Tag : ACTIVE

[Field: TDKBOH Version]
    Use     : Name Field
    Set As  : "1.1.3"
    XML Tag : VERSION

[Field: TDKBOH Report]
    Use     : Name Field
    Set As  : "TDKBillOutstandingWorking"
    XML Tag : REPORT

[Report: TDKBillOutstandingContext]
    Form          : TDKBOC Form
    Title         : "TallyDekho Bill Outstanding Context"
    Keep XML Case : Yes

[Form: TDKBOC Form]
    Parts   : TDKBOC Body
    XML Tag : ENVELOPE

[Part: TDKBOC Body]
    Lines   : TDKBOC Line
    Scroll  : Vertical

[Line: TDKBOC Line]
    Fields  : TDKBOC Active, TDKBOC Version, TDKBOC Company
    XML Tag : TDKCONTEXT

[Field: TDKBOC Active]
    Use     : Name Field
    Set As  : "YES"
    XML Tag : ACTIVE

[Field: TDKBOC Version]
    Use     : Name Field
    Set As  : "1.1.3"
    XML Tag : VERSION

[Field: TDKBOC Company]
    Use     : Name Field
    Set As  : $Name:Company:##SVCurrentCompany
    XML Tag : COMPANY

[Report: TDKBillOutstandingWorking]
    Form          : TDKBO Form
    Title         : "TallyDekho Bill Outstanding"
    Variable      : SVFromDate, SVToDate
    Keep XML Case : Yes

[Form: TDKBO Form]
    Parts   : TDKBO Body
    XML Tag : ENVELOPE

[Part: TDKBO Body]
    Lines   : TDKBO Line
    Repeat  : TDKBO Line : TDKBO Bills
    Scroll  : Vertical

[Line: TDKBO Line]
    Fields  : TDKBO LedgerName, TDKBO BillName, TDKBO BillDate, TDKBO DueDate, TDKBO CreditPeriod, TDKBO Amount, TDKBO PendingAmount, TDKBO DrCr, TDKBO LedgerParent, TDKBO Company
    XML Tag : BILLROW

[Field: TDKBO Company]
    Use     : Name Field
    Set As  : ##SVCurrentCompany
    XML Tag : Company

[Field: TDKBO LedgerName]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LedgerName

[Field: TDKBO BillName]
    Use     : Name Field
    Set As  : $Name
    XML Tag : BillName

[Field: TDKBO BillDate]
    Use     : Name Field
    Set As  : If $$IsEmpty:$BillDate Then "" Else $$PyrlYYYYMMDDFormat:$BillDate:"-"
    XML Tag : BillDate

[Field: TDKBO DueDate]
    Use     : Name Field
    Set As  : ""
    XML Tag : DueDate

[Field: TDKBO CreditPeriod]
    Use     : Name Field
    Set As  : $BillCreditPeriod
    XML Tag : CreditPeriod

[Field: TDKBO Amount]
    Use     : Name Field
    Set As  : $OpeningBalance
    XML Tag : Amount

[Field: TDKBO PendingAmount]
    Use     : Name Field
    Set As  : $ClosingBalance
    XML Tag : PendingAmount

[Field: TDKBO DrCr]
    Use     : Name Field
    Set As  : If $$IsDr:$ClosingBalance Then "Dr" Else "Cr"
    XML Tag : DrCr

[Field: TDKBO LedgerParent]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LedgerParent

[Collection: TDKBO Bills]
    Type   : Bill
    Fetch  : Name, Parent, BillDate, BillCreditPeriod, OpeningBalance, ClosingBalance
    Filter : TDKBO NonBlankBill

[System: Formula]
    TDKBO NonBlankBill : NOT $$IsEmpty:$Name

;; ===== TEMPORARY DIAGNOSTIC PROBES — BEGIN (delete through END after diagnosis) =====
;; Round 1 (done): only lines inside a "Scroll : Vertical" part print over HTTP
;; Export/Data, whatever their data source.
;; Round 2 (done): ##SVCurrentCompany in a scrolling fixed line reports the
;; requested company; a closed or unknown company gives "Could not set
;; 'SVCurrentCompany'"; a fixed line next to a repeated line is dropped.
;; Kept until the 1.1.3 Windows QA passes. Read with scripts/tdl-layout-probe.js.
;; Nothing in the desktop app calls these.

[Report: TDKProbeContext]
    Form          : TDKProbe Context Form
    Keep XML Case : Yes

[Form: TDKProbe Context Form]
    Parts   : TDKProbe Context Part
    XML Tag : ENVELOPE

[Part: TDKProbe Context Part]
    Lines   : TDKProbe Context Line
    Scroll  : Vertical

[Report: TDKProbeContextBills]
    Form          : TDKProbe ContextBills Form
    Variable      : SVFromDate, SVToDate
    Keep XML Case : Yes

[Form: TDKProbe ContextBills Form]
    Parts   : TDKProbe ContextBills Part
    XML Tag : ENVELOPE

[Part: TDKProbe ContextBills Part]
    Lines   : TDKProbe Context Line, TDKProbe Bill Line
    Repeat  : TDKProbe Bill Line : TDKBO Bills
    Scroll  : Vertical

[Line: TDKProbe Context Line]
    Fields  : TDKProbe Active, TDKProbe Version, TDKProbe CurrentCompany, TDKProbe CompanyObject
    XML Tag : PROBE

[Line: TDKProbe Bill Line]
    Fields  : TDKProbe BillLedger, TDKProbe BillName, TDKProbe BillCompany
    XML Tag : PROBEBILL

[Field: TDKProbe Active]
    Use     : Name Field
    Set As  : "YES"
    XML Tag : ACTIVE

[Field: TDKProbe Version]
    Use     : Name Field
    Set As  : "PROBE"
    XML Tag : VERSION

[Field: TDKProbe CurrentCompany]
    Use     : Name Field
    Set As  : ##SVCurrentCompany
    XML Tag : CURRENTCOMPANY

[Field: TDKProbe CompanyObject]
    Use     : Name Field
    Set As  : $Name:Company:##SVCurrentCompany
    XML Tag : COMPANYOBJECT

[Field: TDKProbe BillLedger]
    Use     : Name Field
    Set As  : $Parent
    XML Tag : LEDGER

[Field: TDKProbe BillName]
    Use     : Name Field
    Set As  : $Name
    XML Tag : BILL

[Field: TDKProbe BillCompany]
    Use     : Name Field
    Set As  : ##SVCurrentCompany
    XML Tag : COMPANY

;; ===== TEMPORARY DIAGNOSTIC PROBES — END =====
